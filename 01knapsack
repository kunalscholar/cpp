#include<bits/stdc++.h>
using namespace std;
int minweight = -1;
int ks(int n,int &w, vector<int> &p, vector<int> &wt){
 vector<vector<int>> dp(n+1,vector<int>(w+1,0));
 for(int i=1;i<=n;i++){
    for(int j=0;j<=w;j++){
        if(wt[i-1]>j){
            dp[i][j]=dp[i-1][j];
        }
        else{
         dp[i][j]=max(dp[i-1][j],dp[i-1][j-wt[i-1]]+p[i-1]);
        }
    }
 }
 minweight =  w;
 return dp[n][w];
}
int main(){
 int n = 4;
 vector<int> p = {1,4,5,7};
 vector<int> w= {1,3,4,5};
 int maxw = 7;
 int cost = ks(n,maxw,p,w);
 cout<<"The maximum profit is: "<<cost<<endl;
 cout<<"The weight left is: "<<minweight;
 return 0;
}

